{
  "name": "hermes-ceo-console-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Thin desktop wrapper for Hermes WebUI on localhost:8788",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dmg",
    "build:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.fmg.hermes-ceo-console",
    "productName": "Hermes CEO Console",
    "files": ["main.js", "preload.js", "package.json"],
    "mac": {"target": "dmg"},
    "win": {"target": "nsis"}
  }
}
