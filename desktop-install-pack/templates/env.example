# Copy to ~/.hermes/.env and fill locally. Do not commit secrets.
# Paperclip
# WebUI Paperclip tab embeds this URL. Default: http://127.0.0.1:3100
PAPERCLIP_WEB_URL=http://127.0.0.1:3100
PAPERCLIP_BASE_URL=
PAPERCLIP_DEFAULT_COMPANY=FMG

# Telegram / Hermes Agent integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=

# Codex CLI uses its own login store. Run: codex login
